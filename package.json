{
  "name": "rivet-gymos",
  "private": true,
  "version": "0.1.0",
  "description": "RIVET (working title GymOS) — multi-tenant revenue and operations OS for gyms, built with Next.js, Convex, Clerk, and Vercel.",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:full": "pnpm --filter web dev:full",
    "convex:dev": "pnpm --filter web convex:dev",
    "convex:deploy": "pnpm --filter web convex:deploy",
    "convex:env:names": "pnpm --filter web convex:env:names",
    "convex:codegen": "pnpm --filter web convex:codegen",
    "convex:typecheck": "pnpm --filter web convex:typecheck",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  }
}
