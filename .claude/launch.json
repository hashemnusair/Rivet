        "-p",
        "3160"
      ],
      "port": 3160
    },
    {
      "name": "web-mock-finops",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_DATA_MODE=mock",
        "NEXT_PUBLIC_RIVET_DEMO_AUTH=1",
