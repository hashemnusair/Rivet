# Dependencies — restore with `pnpm install` (pnpm-lock.yaml is committed)
node_modules/
.pnpm-store/

# Fontshare permits self-hosting, but not redistribution in this public repo.
# Restored and verified by apps/web/scripts/prepare-marketing-font.mjs on install.
apps/web/src/components/marketing/fonts/Satoshi-Variable.woff2

# Next.js build output
.next/
# Isolated verification output (custom Next distDir).
.next-arabic-build/
.next-arabic-final/
out/
build/


# Test artefacts
coverage/
test-results/
playwright-report/
playwright/.cache/

# TypeScript incremental build cache
*.tsbuildinfo

# Environment — never commit real values
.env
.env.local
.env*.local

# Local Vercel project links
.vercel/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Next rewrites this file differently in development, Playwright, and build
# output directories. Keep stable framework references in next-types.d.ts and
# ignore the generated file so normal verification never dirties the worktree.
apps/web/next-env.d.ts
.next-playwright-staff*/
