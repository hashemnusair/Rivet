# Created automatically for local development by `pnpm convex:dev`.
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# `convex` is the production default. Set `mock` only for local visual review
# and deterministic tests; production deployments must never use it.
NEXT_PUBLIC_DATA_MODE=convex

# Clerk Dashboard → API keys. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Dashboard → Integrations → Convex.
CLERK_FRONTEND_API_URL=

# Convex deployment environment variables (set with `convex env set`, never in
# browser code or committed files).
ENTRY_PASS_SIGNING_SECRET=
# Required in Convex and Vercel Production. Use a unique random value with at
# least 32 characters and mixed character classes; never commit the value.
RIVET_PUBLIC_REQUEST_PEPPER=
# Local-only fallback switch for deterministic preview/test environments. Keep
# unset in Production so public request protection fails closed.
RIVET_PUBLIC_REQUEST_ALLOW_FALLBACK=0
# Invitation links generated by the protected gym-provisioning action.
RIVET_SITE_URL=https://www.rivetjo.com

# Resend application notifications (Convex-only; never prefix these with
# NEXT_PUBLIC_). Verify rivetjo.com in Resend before using this sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rivetjo.com
RESEND_WEBHOOK_SECRET=
RIVET_APPLICATION_RECIPIENTS=you@example.com,partner@example.com
# Durable operational email is suppressed unless both the global kill switch
# and the individual tenant/global message kind are enabled deliberately.
RIVET_OPERATIONAL_EMAIL_LIVE=false
RIVET_OPERATIONAL_EMAIL_GLOBAL_TYPES=

# Public production origin used by Next.js metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trusted Clerk → Convex Playwright smoke only; storage state must stay outside Git.
PLAYWRIGHT_CONVEX_SMOKE=0
PLAYWRIGHT_CONVEX_OPERATIONAL_FLOW=0
PLAYWRIGHT_CONVEX_REALTIME=0
PLAYWRIGHT_TARGET_CLASSIFICATION=
PLAYWRIGHT_RUN_ID=
PLAYWRIGHT_EXPECTED_CONVEX_URL=
PLAYWRIGHT_PRODUCTION_CONVEX_URL=
PLAYWRIGHT_PRODUCTION_HOSTS=rivetjo.com,www.rivetjo.com
PLAYWRIGHT_STAGING_JOURNEYS=all
PLAYWRIGHT_CLERK_STORAGE_STATE=
# The complete staging harness accepts role-specific files for platform_admin,
# owner, manager, salesperson, receptionist, trainer, member, and foreign_tenant.
PLAYWRIGHT_CLERK_STORAGE_PLATFORM_ADMIN=
PLAYWRIGHT_CLERK_STORAGE_OWNER=
PLAYWRIGHT_CLERK_STORAGE_MANAGER=
PLAYWRIGHT_CLERK_STORAGE_SALESPERSON=
PLAYWRIGHT_CLERK_STORAGE_RECEPTIONIST=
PLAYWRIGHT_CLERK_STORAGE_TRAINER=
PLAYWRIGHT_CLERK_STORAGE_MEMBER=
PLAYWRIGHT_CLERK_STORAGE_FOREIGN_TENANT=
