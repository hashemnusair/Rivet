{
  // Cloudflare deployment config for RIVET.
  //
  // The app is entirely client-rendered against an in-browser mock, so nothing
  // here needs bindings, KV or D1 yet. It is deployed through the Workers
  // runtime (via @opennextjs/cloudflare) rather than as a pure static export
  // because four routes carry dynamic segments — /members/[memberId],
  // /crm/leads/[leadId], /payments/receipts/[receiptId] and
  // /automations/[ruleId] — whose ids are only known at runtime. A static
  // export would require prerendering a fixed id list and would 404 on any
  // record created during a session.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
